{
  "name": "@busos/feishu-migration",
  "version": "1.0.0",
  "private": true,
  "description": "AI Business OS Feishu migration package and manifest contracts.",
  "type": "module",
  "main": "./src/types.ts",
  "types": "./src/types.ts",
  "exports": {
    ".": "./src/types.ts",
    "./hash": "./src/hash.ts",
    "./redact": "./src/redact.ts",
    "./config": "./src/config.ts",
    "./feishu-client": "./src/feishu-client.ts",
    "./base-reader": "./src/base-reader.ts",
    "./sheet-reader": "./src/sheet-reader.ts",
    "./inventory": "./src/inventory.ts",
    "./dedupe": "./src/dedupe.ts",
    "./normalize/common": "./src/normalize/common.ts",
    "./normalize/customers": "./src/normalize/customers.ts",
    "./normalize/projects": "./src/normalize/projects.ts",
    "./normalize/resources": "./src/normalize/resources.ts",
    "./normalize/content": "./src/normalize/content.ts",
    "./target-schema": "./src/target-schema.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./plan": "./src/plan.ts",
    "./apply": "./src/apply.ts",
    "./verify-live": "./src/verify-live.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-cache",
    "verify": "npm run typecheck && npm run test",
    "plan": "vite-node --script ./src/cli.ts plan",
    "bootstrap": "vite-node --script ./src/cli.ts bootstrap",
    "apply": "vite-node --script ./src/cli.ts apply",
    "verify:live": "vite-node --script ./src/cli.ts verify"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
